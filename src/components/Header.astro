---
import HeaderLink from './HeaderLink.astro';
import { CV_URL, SITE_TITLE } from '../consts';
import { url } from '../utils/paths';

const cvHref = CV_URL ? url(CV_URL) : null;
---

<header>
	<nav>
		<h2>
			<a href={url('/')}>{E}</a>
		</h2>

		<div class="internal-links">
			<HeaderLink erLink>
			}>About Me</HeaderLink>
			<HeaderLink href={urlk>
			}>Research</HeaderLink>
			<HeaderLink href={url('/creative-practice'act</HeaderLink>

			{cvHref && (
				{cvHref}
					Resume ↗
				</HeaderLink>
			)}
		</div>
	</nav>
</header>

<script>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        (window as any).__setPreferredTheme?.(newTheme);
        localStorage.setItem('theme', newTheme);
    });

    document.getElementById('menu-toggle')?.addEventListener('click', () => {
        document.getElementById('mobile-menu')?.classList.toggle('hidden');
    });

    document.querySelectorAll('.search-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
            document.dispatchEvent(new CustomEvent('open-search'));
        });
    });
</script>

<style>
	header {
		margin: 0;
		padding: 0 2rem;
		background-color: #050914;
		position: sticky;
		top: 0;
		z-index: 100;
	}

	nav {
		display: flex;
		align-items: center;
		max-width: 1400px;
		margin: 0 auto;
		height: 4.5rem;
	}

	h2 {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 500;
		font-family: var(--font-sans);
		letter-spacing: 0;
	}

	h2 a {
		text-decoration: none;
		color: white;
		border: none;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		margin-left: auto;
	}

	.internal-links :global(a) {
		color: white;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		border: none;
		padding: 0;
		transition: color 0.2s ease;
	}

	.internal-links :global(a:hover) {
		color: #d1d5db;
	}

	.internal-links :global(a.active) {
		color: white;
		border: none;
	}

	@media (max-width: 768px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
			height: auto;
			padding: 1rem 0;
			gap: 1rem;
		}

		.internal-links {
			margin-left: 0;
			flex-wrap: wrap;
			gap: 1rem;
		}
	}
</style>
