---
import HeaderLink from './HeaderLink.astro';
import { CV_URL, SITE_TITLE } from '../consts';
import { url } from '../utils/paths';

const cvHref = CV_URL ? url(CV_URL) : null;
---

<header>
	<nav>
		<div class="site-name">
			<a href={url('/')}>{SITE_TITLE}</a>
		</div>

		<div class="internal-links">
			<HeaderLink href={url('/')}>Home</HeaderLink>
			<HeaderLink href={url('/about')}>About Me</HeaderLink>
			<HeaderLink href={url('/projects')}>Projects</HeaderLink>
			<HeaderLink href={url('/research')}>Research</HeaderLink>
			<HeaderLink href={url('/creative-practice')}>Creative Practice</HeaderLink>
			<HeaderLink href={url('/contact')}>Contact</HeaderLink>

			{cvHref && (
				<HeaderLink href={cvHref} target="_blank">Resume ↗</HeaderLink>
			)}
		</div>

		<button
			id="menu-toggle"
			class="menu-button"
			aria-label="Toggle Menu"
			aria-expanded="false"
		>
			Menu
		</button>
	</nav>

	<div id="mobile-menu" class="mobile-menu hidden">
		<a href={url('/')}>Home</a>
		<a href={url('/about')}>About Me</a>
		<a href={url('/projects')}>Projects</a>
		<a href={url('/research')}>Research</a>
		<a href={url('/creative-practice')}>Creative Practice</a>
		<a href={url('/contact')}>Contact</a>

		{cvHref && (
			<a href={cvHref} target="_blank">Resume</a>
		)}
	</div>
</header>

<script>
	const menuToggle = document.getElementById('menu-toggle');
	const mobileMenu = document.getElementById('mobile-menu');

	menuToggle?.addEventListener('click', () => {
		const isHidden = mobileMenu?.classList.toggle('hidden');

		menuToggle.setAttribute(
			'aria-expanded',
			String(!isHidden)
		);
	});
</script>

<style>
	header {
		margin: 0;
		padding: 0 2rem;
		background-color: var(--color-bg-header);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	header::after {
		content: "";
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--color-border);
		opacity: 0.6;
	}

	nav {
		display: flex;
		align-items: center;
		max-width: 1420px;
		margin: 0 auto;
		height: 4rem;
	}

	/* Your name */
.site-name {
	margin: 0;
	padding: 0;
	white-space: nowrap;
}

.site-name a {
	font-family: var(--font-serif);
	font-size: 1.05rem;
	font-weight: 650;
	line-height: 1;
	color: var(--color-text-main);
	text-decoration: none !important;
	border: 0 !important;
	border-bottom: 0 !important;
	box-shadow: none !important;
	background-image: none !important;
}

.site-name a:hover,
.site-name a:focus,
.site-name a:visited {
	color: var(--color-text-main);
	text-decoration: none !important;
	border: 0 !important;
	border-bottom: 0 !important;
	box-shadow: none !important;
	background-image: none !important;
}

	/* Navigation */
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.15rem;
		margin-left: auto;
	}

	.internal-links :global(a) {
		padding: 0;
		color: var(--color-text-main);
		border: none;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 550;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.internal-links :global(a:hover) {
		color: var(--color-accent);
	}

	/* Active page */
	.internal-links :global(a.active) {
		color: var(--color-accent);
		text-decoration: none;
		border: none;
	}

	/* Mobile button */
	.menu-button {
		display: none;
		margin-left: auto;
		padding: 0;
		background: transparent;
		border: none;
		color: var(--color-text-main);
		font-family: inherit;
		font-size: 0.9rem;
		font-weight: 500;
		cursor: pointer;
	}

	.menu-button:hover {
		color: var(--color-accent);
	}

	/* Mobile menu */
	.mobile-menu {
		position: absolute;
		top: calc(100% + 0.5rem);
		right: 1rem;
		width: max-content;
		min-width: 190px;
		background-color: var(--color-bg-mobile-menu);
		backdrop-filter: blur(40px) saturate(150%);
		-webkit-backdrop-filter: blur(40px) saturate(150%);
		border: 1px solid var(--color-header-border);
		border-radius: 10px;
		padding: 0.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		box-shadow:
			0 8px 32px rgba(0, 0, 0, 0.12),
			0 2px 8px rgba(0, 0, 0, 0.08);
		z-index: 200;
		animation: menuFadeIn 0.2s ease;
	}

	.mobile-menu a {
		padding: 0.55rem 0.875rem;
		text-decoration: none;
		color: var(--color-text-main);
		font-weight: 500;
		font-size: 0.9rem;
		border-radius: 7px;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	.mobile-menu a:hover {
		background-color: var(--color-bg-offset);
		color: var(--color-accent);
	}

	.hidden {
		display: none;
	}

	@keyframes menuFadeIn {
		from {
			opacity: 0;
			transform: translateY(-8px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Desktop */
	@media (min-width: 721px) {
		.mobile-menu {
			display: none !important;
		}
	}

	/* Mobile */
	@media (max-width: 720px) {
		.internal-links {
			display: none;
		}

		.menu-button {
			display: block;
		}
	}
</style>
