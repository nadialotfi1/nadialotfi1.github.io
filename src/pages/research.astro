---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Research | ${SITE_TITLE}`}
			description="Selected biomedical engineering research and experimental work."
		/>

		<style>
			main {
				max-width: none;
				padding: 0;
				background: #050814;
			}

			.research-page {
				min-height: 100vh;
				background:
					radial-gradient(
						ellipse at 18% 4%,
						rgba(49, 70, 105, 0.24) 0%,
						transparent 48%
					),
					radial-gradient(
						ellipse at 82% 32%,
						rgba(35, 50, 78, 0.14) 0%,
						transparent 45%
					),
					#050814;
			}

			.research-inner {
				max-width: 1100px;
				margin: 0 auto;
				padding: 4.5rem 0 6rem;
			}

			/* =========================
			   PAGE HEADER
			   ========================= */

			.page-header {
				padding-bottom: 2rem;
				border-bottom: 1px solid #334155;
			}

			.page-header h1 {
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: clamp(2rem, 3vw, 2.6rem);
				font-weight: 700;
				color: var(--color-text-main);
			}

			.page-header p {
				max-width: 720px;
				margin: 1rem 0 0;
				font-size: 1rem;
				line-height: 1.7;
				color: var(--color-text-muted);
			}

			/* =========================
			   RESEARCH ITEM
			   ========================= */

			.research-item {
				padding: 4.5rem 0;
				border-bottom: 1px solid #334155;
			}

			.research-item:last-child {
				border-bottom: none;
			}

			.research-top {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 2rem;
				margin-bottom: 2rem;
			}

			.research-label {
				display: block;
				margin-bottom: 0.65rem;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.13em;
				text-transform: uppercase;
				color: #80b7f4;
			}

			.research-title {
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: clamp(1.7rem, 2.5vw, 2.2rem);
				line-height: 1.25;
				color: var(--color-text-main);
			}

			.research-meta {
				margin: 0.65rem 0 0;
				font-size: 0.86rem;
				color: #64748b;
			}

			.research-year {
				margin: 0;
				font-size: 0.85rem;
				color: #64748b;
				white-space: nowrap;
			}

			/* =========================
			   HERO VISUAL
			   ========================= */

			.hero-visual {
				width: 100%;
				aspect-ratio: 16 / 7;
				overflow: hidden;
				margin-bottom: 2.5rem;
				border: 1px solid #334155;
				border-radius: 16px;
				background:
					linear-gradient(
						135deg,
						#172033,
						#0b1020
					);
			}

			.hero-visual img {
				width: 100%;
				height: 100%;
				display: block;
				object-fit: cover;
			}

			.visual-placeholder {
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #64748b;
			}

			/* =========================
			   INFO
			   ========================= */

			.research-info-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2.5rem 4rem;
			}

			.research-section h3 {
				margin: 0 0 0.8rem;
				font-family: var(--font-serif);
				font-size: 1.2rem;
				color: var(--color-text-main);
			}

			.research-section p {
				margin: 0;
				font-size: 0.94rem;
				line-height: 1.75;
				color: var(--color-text-muted);
			}

			/* =========================
			   SKILLS
			   ========================= */

			.skills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.skill {
				padding: 0.35rem 0.7rem;
				border: 1px solid #334155;
				border-radius: 999px;
				font-size: 0.72rem;
				color: #cbd5e1;
			}

			/* =========================
			   OUTCOMES
			   ========================= */

			.outcomes {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
				margin-top: 2.5rem;
			}

			.outcome-card {
				padding: 1.3rem;
				border: 1px solid #334155;
				border-radius: 12px;
				background: rgba(15, 23, 42, 0.35);
			}

			.outcome-card strong {
				display: block;
				margin-bottom: 0.35rem;
				font-family: var(--font-serif);
				font-size: 1.65rem;
				color: #80b7f4;
			}

			.outcome-card span {
				display: block;
				font-size: 0.78rem;
				line-height: 1.5;
				color: var(--color-text-muted);
			}

			/* =========================
			   GALLERY
			   ========================= */

			.gallery-title {
				margin: 2.75rem 0 1rem;
				font-family: var(--font-serif);
				font-size: 1.2rem;
				color: var(--color-text-main);
			}

			.gallery {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1rem;
			}

			.gallery-item {
				aspect-ratio: 4 / 3;
				overflow: hidden;
				border: 1px solid #334155;
				border-radius: 12px;
				background: #0b1020;
			}

			.gallery-item img {
				width: 100%;
				height: 100%;
				display: block;
				object-fit: cover;
			}

			.gallery-placeholder {
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 1rem;
				text-align: center;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: #64748b;
			}

			/* =========================
			   RESPONSIVE
			   ========================= */

			@media (max-width: 800px) {
				.research-inner {
					padding-left: 2rem;
					padding-right: 2rem;
				}

				.research-info-grid {
					grid-template-columns: 1fr;
					gap: 2rem;
				}

				.outcomes {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 600px) {
				.research-inner {
					padding: 3rem 1rem 4rem;
				}

				.research-item {
					padding: 3.5rem 0;
				}

				.research-top {
					display: block;
				}

				.research-year {
					margin-top: 0.75rem;
				}

				.hero-visual {
					aspect-ratio: 4 / 3;
				}

				.gallery {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="research-page">
				<div class="research-inner">

					<section class="page-header">
						<h1>Research</h1>

						<p>
							Selected biomedical engineering research spanning
							experimental biology, quantitative image analysis,
							and medical imaging.
						</p>
					</section>

					<!-- ========================================
					     RESEARCH 1: MITOCHONDRIAL
					     ======================================== -->

					<section class="research-item">
						<div class="research-top">
							<div>
								<span class="research-label">
									Biomedical Research
								</span>

								<h2 class="research-title">
									Mitochondrial Transplantation &
									Diabetic Endothelial Dysfunction
								</h2>

								<p class="research-meta">
									Bin Jiang Lab · Northwestern University
								</p>
							</div>

							<p class="research-year">2025–2026</p>
						</div>

						<div class="hero-visual">
							<div class="visual-placeholder">
								Add Main Research Image
							</div>
						</div>

						<div class="research-info-grid">
							<div class="research-section">
								<h3>Research Question</h3>
								<p>
									Can mitochondrial transplantation help restore
									endothelial function impaired by diabetes and
									support improved tissue repair?
								</p>
							</div>

							<div class="research-section">
								<h3>Approach</h3>
								<p>
									Designed and performed experiments evaluating
									mitochondrial transplantation through measurements
									of viability, mitochondrial function, inflammatory
									markers, migration, wound models, histology,
									and microscopy-based analysis.
								</p>
							</div>

							<div class="research-section">
								<h3>Methods & Skills</h3>

								<div class="skills">
									<span class="skill">Cell Culture</span>
									<span class="skill">Histology</span>
									<span class="skill">Microscopy</span>
									<span class="skill">ImageJ</span>
									<span class="skill">Python</span>
									<span class="skill">Experimental Design</span>
									<span class="skill">Statistical Analysis</span>
								</div>
							</div>

							<div class="research-section">
								<h3>Progress / Outcomes</h3>
								<p>
									Completed a series of experiments and quantitative
									image analyses contributing data and figures toward
									an in-progress manuscript.
								</p>
							</div>
						</div>

						<div class="outcomes">
							<div class="outcome-card">
								<strong>10+</strong>
								<span>Experiments designed and performed</span>
							</div>

							<div class="outcome-card">
								<strong>500+</strong>
								<span>Microscopy images analyzed</span>
							</div>

							<div class="outcome-card">
								<strong>$4,500</strong>
								<span>McCormick Summer Research Grant</span>
							</div>
						</div>

						<h3 class="gallery-title">Gallery</h3>

						<div class="gallery">
							<div class="gallery-item">
								<div class="gallery-placeholder">
									Microscopy
								</div>
							</div>

							<div class="gallery-item">
								<div class="gallery-placeholder">
									Experimental Workflow
								</div>
							</div>

							<div class="gallery-item">
								<div class="gallery-placeholder">
									Histology / Staining
								</div>
							</div>

							<div class="gallery-item">
								<div class="gallery-placeholder">
									Quantitative Analysis / Figure
								</div>
							</div>
						</div>
					</section>

					<!-- ========================================
					     RESEARCH 2: MRI
					     ======================================== -->

					<section class="research-item">
						<div class="research-top">
							<div>
								<span class="research-label">
									Medical Imaging
								</span>

								<h2 class="research-title">
									Low-Field MRI & T1 Relaxometry
								</h2>

								<p class="research-meta">
									Magnetic Resonance Technology Discovery Lab · Northwestern University
								</p>
							</div>

							<p class="research-year">2023</p>
						</div>

						<div class="hero-visual">
							<div class="visual-placeholder">
								Add MRI / Phantom Image
							</div>
						</div>

						<div class="research-info-grid">
							<div class="research-section">
								<h3>Research Question</h3>
								<p>
									How effectively can low-field MRI characterize
									T1 relaxation behavior in gadolinium contrast phantoms,
									and what does that imply for more accessible imaging systems?
								</p>
							</div>

							<div class="research-section">
								<h3>Approach</h3>
								<p>
									Performed precision testing and data collection using
									the Hyperfine Swoop low-field MRI system, then analyzed
									relaxation data using MATLAB and qMRLab for signal fitting
									and T1 relaxometry.
								</p>
							</div>

							<div class="research-section">
								<h3>Methods & Skills</h3>

								<div class="skills">
									<span class="skill">MRI</span>
									<span class="skill">T1 Relaxometry</span>
									<span class="skill">MATLAB</span>
									<span class="skill">qMRLab</span>
									<span class="skill">Signal Fitting</span>
									<span class="skill">Quantitative Analysis</span>
								</div>
							</div>

							<div class="research-section">
								<h3>Progress / Outcomes</h3>
								<p>
									Evaluated low-field MRI data and contrast behavior
									while exploring the potential of lower-cost imaging
									systems for more accessible diagnostic applications.
								</p>
							</div>
						</div>

						<h3 class="gallery-title">Gallery</h3>

						<div class="gallery">
							<div class="gallery-item">
								<div class="gallery-placeholder">
									Hyperfine Swoop / MRI Setup
								</div>
							</div>

							<div class="gallery-item">
								<div class="gallery-placeholder">
									Gadolinium Phantom
								</div>
							</div>

							<div class="gallery-item">
								<div class="gallery-placeholder">
									T1 Relaxation Curve
								</div>
							</div>

							<div class="gallery-item">
								<div class="gallery-placeholder">
									MATLAB / qMRLab Analysis
								</div>
							</div>
						</div>
					</section>

				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
