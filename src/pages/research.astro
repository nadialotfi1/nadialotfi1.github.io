---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { url } from '../utils/paths';

const research = [
	{
		title: 'Mitochondrial Transplantation & Diabetic Endothelial Dysfunction',
		lab: 'Bin Jiang Lab',
		institution: 'Northwestern University',
		description:
			'Investigating mitochondrial transplantation as a potential therapeutic strategy for impaired endothelial function in diabetes.',
		skills: ['Cell Culture', 'Histology', 'ImageJ', 'Python', 'Experimental Design'],
		image: null,
		link: '/research/mitochondrial-transplantation',
	},
	{
		title: 'Low-Field MRI & T1 Relaxometry',
		lab: 'Magnetic Resonance Technology Discovery Lab',
		institution: 'Northwestern University',
		description:
			'Quantitative analysis of gadolinium contrast phantoms using low-field MRI and T1 relaxometry.',
		skills: ['MRI', 'MATLAB', 'qMRLab', 'Signal Analysis'],
		image: null,
		link: '/research/low-field-mri',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Research | ${SITE_TITLE}`}
			description="Research experience and selected biomedical research work."
		/>

		<style>
			main {
				max-width: none;
				padding: 0;
				background: #050814;
			}

			.research-page {
				min-height: 100vh;
				background:
					radial-gradient(
						ellipse at 18% 5%,
						rgba(49, 70, 105, 0.25),
						transparent 50%
					),
					#050814;
			}

			.research-inner {
				max-width: 1100px;
				margin: 0 auto;
				padding: 4.5rem 0 6rem;
			}

			.page-header {
				padding-bottom: 2rem;
				border-bottom: 1px solid #334155;
			}

			.page-header h1 {
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: clamp(2rem, 3vw, 2.6rem);
				font-weight: 700;
				color: var(--color-text-main);
			}

			.page-header p {
				max-width: 700px;
				margin: 1rem 0 0;
				font-size: 1rem;
				line-height: 1.7;
				color: var(--color-text-muted);
			}

			.research-list {
				padding-top: 3rem;
			}

			.research-item {
				display: grid;
				grid-template-columns: 320px minmax(0, 1fr);
				gap: 3rem;
				padding: 2.5rem 0;
				border-bottom: 1px solid #334155;
			}

			.research-item:first-child {
				padding-top: 0;
			}

			.research-image {
				width: 100%;
				aspect-ratio: 4 / 3;
				overflow: hidden;
				border: 1px solid #334155;
				border-radius: 14px;
				background:
					linear-gradient(
						135deg,
						#172033,
						#0b1020
					);
			}

			.research-image img {
				width: 100%;
				height: 100%;
				display: block;
				object-fit: cover;
			}

			.image-placeholder {
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #64748b;
			}

			.research-lab {
				display: block;
				margin-bottom: 0.7rem;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #80b7f4;
			}

			.research-item h2 {
				display: block;
				margin: 0 0 0.5rem;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.55rem;
				line-height: 1.35;
				color: var(--color-text-main);
			}

			.institution {
				margin: 0 0 1rem;
				font-size: 0.85rem;
				color: #64748b;
			}

			.research-description {
				max-width: 650px;
				margin: 0 0 1.25rem;
				font-size: 0.95rem;
				line-height: 1.75;
				color: var(--color-text-muted);
			}

			.skills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				margin-bottom: 1.4rem;
			}

			.skill {
				padding: 0.3rem 0.65rem;
				border: 1px solid #334155;
				border-radius: 999px;
				font-size: 0.72rem;
				color: #cbd5e1;
			}

			.view-research {
				font-size: 0.88rem;
				font-weight: 600;
				color: #80b7f4;
				text-decoration: none;
			}

			.view-research:hover {
				color: #a7cffb;
				text-decoration: none;
			}

			@media (max-width: 800px) {
				.research-inner {
					padding-left: 2rem;
					padding-right: 2rem;
				}

				.research-item {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}

				.research-image {
					max-width: 500px;
				}
			}

			@media (max-width: 600px) {
				.research-inner {
					padding: 3rem 1rem 4rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="research-page">
				<div class="research-inner">

					<section class="page-header">
						<h1>Research</h1>

						<p>
							My research interests center on biomedical engineering,
							experimental systems, and technologies that can translate
							from the lab into meaningful real-world applications.
						</p>
					</section>

					<div class="research-list">

						{research.map((item) => (
							<article class="research-item">

								<div class="research-image">
									{item.image ? (
										<img src={url(item.image)} alt={item.title} />
									) : (
										<div class="image-placeholder">
											Add Research Image
										</div>
									)}
								</div>

								<div class="research-content">

									<span class="research-lab">
										{item.lab}
									</span>

									<h2>{item.title}</h2>

									<p class="institution">
										{item.institution}
									</p>

									<p class="research-description">
										{item.description}
									</p>

									<div class="skills">
										{item.skills.map((skill) => (
											<span class="skill">{skill}</span>
										))}
									</div>

									<a
										href={url(item.link)}
										class="view-research"
									>
										View Research →
									</a>

								</div>

							</article>
						))}

					</div>

				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
