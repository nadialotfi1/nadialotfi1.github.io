---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CV_URL } from '../consts';
import { url } from '../utils/paths';

const cvHref = CV_URL ? url(CV_URL) : null;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

		<style>
			main {
				max-width: none;
				padding: 0;
				background: transparent;
			}

			/* =========================
			   HERO / INTRO
			   ========================= */

			.intro-section {
				background: linear-gradient(
					to bottom,
					#172033 0%,
					#111827 35%,
					#0b1020 70%,
					#050814 100%
				);
				border-bottom: 1px solid #334155;
			}

			.hero {
				max-width: 1100px;
				margin: 0 auto;
				padding: 6.5rem 0 4rem;
				position: relative;
				z-index: 1;
			}

			.hero-label {
				margin: 0 0 1.25rem;
				font-family: var(--font-sans);
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--color-text-muted);
			}

			.hero h1 {
				margin: 0 0 1rem;
				font-family: var(--font-serif);
				font-size: clamp(2.6rem, 4vw, 3.6rem);
				font-weight: 700;
				letter-spacing: -0.035em;
				line-height: 1;
				color: var(--color-text-main);
			}

			.hero-intro {
				max-width: 720px;
				margin: 0;
				font-family: var(--font-sans);
				font-size: 1.15rem;
				line-height: 1.75;
				color: var(--color-text-main);
			}

			.hero-buttons {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 2.25rem;
			}

			.hero-button {
				display: inline-flex;
				align-items: center;
				justify-content: center;

				min-height: 48px;
				padding: 0.7rem 1.35rem;

				border: 1px solid #334155;
				border-radius: 999px;

				font-family: var(--font-sans);
				font-size: 0.9rem;
				font-weight: 600;

				color: var(--color-text-main);
				background: transparent;
				text-decoration: none;

				transition:
					background-color 0.2s ease,
					border-color 0.2s ease,
					color 0.2s ease;
			}

			.hero-button:hover {
				border-color: #60a5fa;
				color: var(--color-text-main);
				text-decoration: none;
			}

			.hero-button.primary {
				background: #80b7f4;
				border-color: #80b7f4;
				color: #07101f;
			}

			.hero-button.primary:hover {
				background: #9bc7f8;
				border-color: #9bc7f8;
				color: #07101f;
			}

			/* =========================
			   BIO
			   ========================= */

			.bio-section {
				max-width: 820px;
				margin: 0 auto;
				padding: 1.75rem 2rem 7rem;
				position: relative;
				z-index: 1;
			}

			.bio-section p {
				margin: 0;
				font-size: 1.05rem;
				line-height: 1.85;
				color: var(--color-text-main);
			}

			/* =========================
			   FEATURED HIGHLIGHTS
			   ========================= */

			.highlights-section {
				padding: 4.5rem 2rem 5rem;
				background: #111827;
				border-bottom: 1px solid #334155;
			}

			.highlights-inner {
				max-width: 1100px;
				margin: 0 auto;
			}

			.highlights-heading {
				margin: 0;
				padding: 0;
				border: none;
				display: block;

				font-family: var(--font-serif);
				font-size: 2rem;
				font-weight: 700;
				color: var(--color-text-main);
			}

			.highlights-subtitle {
				margin: 0.75rem 0 2.5rem;
				font-size: 0.95rem;
				color: var(--color-text-muted);
			}

			.highlight-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
			}

			.highlight-card {
				display: flex;
				flex-direction: column;
				min-height: 260px;
				padding: 1.65rem;

				border: 1px solid var(--color-border);
				border-radius: 14px;
				background: transparent;
			}

			.card-label {
				margin-bottom: 1.1rem;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: #80b7f4;
			}

			.highlight-card h3 {
				margin: 0 0 0.8rem;
				font-family: var(--font-serif);
				font-size: 1.35rem;
				line-height: 1.4;
				color: var(--color-text-main);
			}

			.highlight-card p {
				margin: 0 0 1.5rem;
				font-size: 0.92rem;
				line-height: 1.7;
				color: var(--color-text-muted);
			}

			.card-link {
				margin-top: auto;
				font-size: 0.88rem;
				font-weight: 600;
				color: #80b7f4;
				text-decoration: none;
			}

			.card-link:hover {
				color: #a7cffb;
				text-decoration: none;
			}

			/* =========================
			   RESPONSIVE
			   ========================= */

			@media (max-width: 800px) {
				.hero {
					padding-top: 4rem;
				}

				.highlight-grid {
					grid-template-columns: 1fr;
				}

				.highlight-card {
					min-height: auto;
				}
			}

			@media (max-width: 600px) {
				.hero {
					padding: 3.5rem 1rem 3rem;
				}

				.bio-section {
					padding: 1rem 1rem 4rem;
				}

				.highlights-section {
					padding: 3.5rem 1rem 4rem;
				}

				.hero-intro {
					font-size: 1.05rem;
				}

				.hero-buttons {
					gap: 0.6rem;
				}

				.hero-button {
					padding: 0.65rem 1rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="intro-section">
				<section class="hero">
					<p class="hero-label">Northwestern University</p>

					<h1>Nadia Lotfi</h1>

					<p class="hero-intro">
						Your short one- or two-line introduction goes here. Describe what you
						work on, what you care about, or the intersection of your interests.
					</p>

					<div class="hero-buttons">
						<a href={url('/about')} class="hero-button primary">
							About Me
						</a>

						<a href={url('/research')} class="hero-button">
							Research
						</a>

						<a href={url('/projects')} class="hero-button">
							Projects
						</a>

						<a href={url('/contact')} class="hero-button">
							Contact
						</a>

						{cvHref && (
							<a
								href={cvHref}
								target="_blank"
								rel="noopener noreferrer"
								class="hero-button"
							>
								Resume (PDF)
							</a>
						)}
					</div>
				</section>

				<section class="bio-section">
					<p>
						Write a slightly longer introduction here. This can be two or three
						sentences about your background, current work, research interests,
						creative practice, and the kinds of questions or projects you are
						interested in pursuing.
					</p>
				</section>
			</div>

			<section class="highlights-section">
				<div class="highlights-inner">
					<h2 class="highlights-heading">Featured highlights</h2>

					<p class="highlights-subtitle">
						A few things I’m especially interested in right now.
					</p>

					<div class="highlight-grid">
						<article class="highlight-card">
							<span class="card-label">Project</span>

							<h3>Featured Project</h3>

							<p>
								A short description of this project and what makes it
								interesting or important.
							</p>

							<a href={url('/projects')} class="card-link">
								Explore
							</a>
						</article>

						<article class="highlight-card">
							<span class="card-label">Project</span>

							<h3>Featured Project</h3>

							<p>
								A short description of this project, experiment,
								or current body of work.
							</p>

							<a href={url('/projects')} class="card-link">
								Explore
							</a>
						</article>

						<article class="highlight-card">
							<span class="card-label">Research</span>

							<h3>Featured Research</h3>

							<p>
								A short description of your research focus, publication,
								or current area of investigation.
							</p>

							<a href={url('/research')} class="card-link">
								Explore
							</a>
						</article>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
