---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { url } from '../../utils/paths';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Oscillometric Blood Pressure Monitoring System | ${SITE_TITLE}`}
			description="Design and analysis of an oscillometric blood pressure monitoring system using analog instrumentation and Python signal processing."
		/>

		<style>
			main {
				max-width: none;
				padding: 0;
				background: #050814;
			}

			.project-page {
				min-height: 100vh;
				background:
					radial-gradient(
						ellipse at 18% 5%,
						rgba(49, 70, 105, 0.22),
						transparent 50%
					),
					#050814;
			}

			.project-inner {
				max-width: 1100px;
				margin: 0 auto;
				padding: 4rem 0 6rem;
			}

			.label {
				display: block;
				margin-bottom: 0.75rem;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.13em;
				text-transform: uppercase;
				color: #94a3b8;
			}

			.section-title {
				display: block;
				margin: 0 0 1rem;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.65rem;
				color: var(--color-text-main);
			}

			.section-copy p {
				margin: 0 0 0.9rem;
				font-size: 0.95rem;
				line-height: 1.75;
				color: #cbd5e1;
			}

			.section-copy p:last-child {
				margin-bottom: 0;
			}

			/* HERO */

			.back-link {
				display: inline-block;
				margin-bottom: 2rem;
				font-size: 0.82rem;
				font-weight: 600;
				color: #80b7f4;
				text-decoration: none;
			}

			.project-hero {
				padding-bottom: 3.5rem;
				border-bottom: 1px solid #334155;
			}

			.project-hero h1 {
				max-width: 900px;
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: clamp(2.2rem, 3.5vw, 3rem);
				line-height: 1.15;
				color: var(--color-text-main);
			}

			.project-meta {
				margin: 1.2rem 0 0;
				font-size: 0.95rem;
				color: var(--color-text-muted);
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem;
				margin-top: 1.5rem;
			}

			.tag {
				padding: 0.35rem 0.7rem;
				border-radius: 999px;
				background: #172033;
				font-size: 0.72rem;
				color: #cbd5e1;
			}

			/* OVERVIEW + PROBLEM */

			.text-section {
				display: grid;
				grid-template-columns: 180px minmax(0, 1fr);
				gap: 4rem;
				padding: 3.5rem 0;
				border-bottom: 1px solid #334155;
			}

			.text-section h2 {
				display: block;
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.45rem;
				color: var(--color-text-main);
			}

			/* PROCESS */

			.process-section {
				padding: 4rem 0;
				border-bottom: 1px solid #334155;
			}

			.process-heading {
				max-width: 760px;
				margin-bottom: 2.5rem;
			}

			.process-step {
				display: grid;
				grid-template-columns: 0.85fr 1.15fr;
				gap: 4rem;
				align-items: center;
				margin-bottom: 4rem;
			}

			.process-step:last-child {
				margin-bottom: 0;
			}

			.process-step.reverse {
				grid-template-columns: 1.15fr 0.85fr;
			}

			.process-image img {
				width: 100%;
				height: auto;
				display: block;
			}

			.system-images {
	display: flex;
	justify-content: center;
	align-items: center;
}

.system-images img {
	display: block;
	width: min(100%, 700px);
	height: auto;
}

			/* RESULTS */

			.results-section {
				padding: 4rem 0 0;
			}

			.results-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
				margin: 1.75rem 0 2.25rem;
			}

			.result-card {
				min-height: 72px;
				padding: 0.9rem 1.1rem;
				border: 1px solid #334155;
				border-radius: 10px;
				background: #111827;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.result-card span {
				margin-bottom: 0.3rem;
				font-size: 0.61rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: #94a3b8;
			}

			.result-card strong {
				font-family: var(--font-serif);
				font-size: 1.3rem;
				color: var(--color-text-main);
			}

			.results-image {
				display: flex;
				justify-content: center;
			}

			.results-image img {
				width: min(100%, 760px);
				height: auto;
				display: block;
			}

			@media (max-width: 850px) {
				.project-inner {
					padding-left: 2rem;
					padding-right: 2rem;
				}

				.text-section,
				.process-step,
				.process-step.reverse {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}

				.results-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 600px) {
				.project-inner {
					padding: 3rem 1rem 4rem;
				}

				.system-images {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="project-page">
				<div class="project-inner">

					<section class="project-hero">

						<a href={url('/projects')} class="back-link">
							← Back to Projects
						</a>

						<h1>
							Oscillometric Blood Pressure Monitoring System
						</h1>

						<p class="project-meta">
							Biomedical Instrumentation · 2026
						</p>

						<div class="tags">
							<span class="tag">Python</span>
							<span class="tag">Signal Processing</span>
							<span class="tag">Analog Circuits</span>
							<span class="tag">Instrumentation</span>
						</div>

					</section>


					<!-- OVERVIEW -->

					<section class="text-section">

						<h2>Overview</h2>

						<div class="section-copy">
							<p>
								Designed an instrumentation system that converts
								pressure changes in a blood-pressure cuff into electrical
								signals that can be filtered and analyzed. Python signal processing was then used to estimate
								systolic pressure, mean arterial pressure, and diastolic
								pressure from the oscillometric waveform.
							</p>
						</div>

					</section>


					<!-- PROBLEM -->

					<section class="text-section">

						<h2>Problem</h2>

						<div class="section-copy">
							<p>
								The physiologically useful pulse oscillations are much
								smaller than the overall cuff-pressure signal. With this in mind, the system needed to amplify the sensor output while
								separating arterial oscillations from the slow pressure
								trend and electrical noise.
							</p>
						</div>

					</section>


					<!-- PROCESS -->

					<section class="process-section">

						<div class="process-heading">
							<span class="label">Process</span>

							<h2 class="section-title">
								From analog instrumentation to physiological estimates
							</h2>
						</div>


						<div class="process-step">

							<div class="section-copy">
								<span class="label">01 · Instrumentation</span>

								<h2 class="section-title">
									Acquiring and filtering the signal
								</h2>

								<p>
									The pressure-sensor output was amplified with an
									INA121 instrumentation amplifier and split into two
									channels. One preserved raw cuff pressure while high- and
									low-pass filtering isolated the smaller pulse-related
									oscillations on the second channel.
								</p>
							</div>

							<div class="system-images">
	<img
		src={url('/blood-pressure-circuit.png')}
		alt="Blood pressure instrumentation circuit showing pressure sensing, amplification, and filtering"
	/>
</div>

						</div>


						<div class="process-step reverse">

							<div class="process-image">
								<img
									src={url('/blood-pressure-time-domain.png')}
									alt="Raw and filtered cuff pressure signals"
								/>
							</div>

							<div class="section-copy">
								<span class="label">02 · Signal Processing</span>

								<h2 class="section-title">
									Isolating the oscillation envelope
								</h2>

								<p>
									The filtered signal reveals the arterial pulsations
									that appear as the cuff gradually deflates. Python was used to trim the useful signal region,
									detect oscillation peaks and troughs, and calculate
									peak-to-peak amplitude.
								</p>
							</div>

						</div>


						<div class="process-step">

							<div class="section-copy">
								<span class="label">03 · Estimation</span>

								<h2 class="section-title">
									Converting oscillations into blood pressure
								</h2>

								<p>
									The maximum oscillation amplitude was used to estimate
									mean arterial pressure. Percentage thresholds on the
									rising and falling sides of the envelope were then
									used to estimate systolic and diastolic pressure.
								</p>
							</div>

							<div class="process-image">
								<img
									src={url('/blood-pressure-peaks.png')}
									alt="Peak detection and oscillation amplitude analysis"
								/>
							</div>

						</div>

					</section>


					<!-- RESULTS -->

					<section class="results-section">

						<span class="label">Results</span>

						<h2 class="section-title">
							Signal-derived blood-pressure estimates
						</h2>

						<div class="results-grid">

							<div class="result-card">
								<span>Systolic</span>
								<strong>135.7 mmHg</strong>
							</div>

							<div class="result-card">
								<span>Mean Arterial Pressure</span>
								<strong>89.3 mmHg</strong>
							</div>

							<div class="result-card">
								<span>Diastolic</span>
								<strong>70.4 mmHg</strong>
							</div>

						</div>

						<div class="results-image">
							<img
								src={url('/blood-pressure-results.png')}
								alt="Final blood pressure analysis"
							/>
						</div>

					</section>

				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
