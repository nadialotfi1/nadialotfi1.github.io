---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { url } from '../../utils/paths';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Oscillometric Blood Pressure Monitoring System | ${SITE_TITLE}`}
			description="Design and analysis of an oscillometric blood pressure monitoring system using analog instrumentation and Python signal processing."
		/>

		<style>
			main {
				max-width: none;
				padding: 0;
				background: #050814;
			}

			.project-page {
				min-height: 100vh;
				background:
					radial-gradient(
						ellipse at 18% 5%,
						rgba(49, 70, 105, 0.22),
						transparent 50%
					),
					#050814;
			}

			.project-inner {
				max-width: 1100px;
				margin: 0 auto;
				padding: 4rem 0 6rem;
			}

			.label {
				display: block;
				margin-bottom: 0.75rem;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.13em;
				text-transform: uppercase;
				color: #94a3b8;
			}

			.section-title {
				display: block;
				margin: 0 0 1rem;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.6rem;
				line-height: 1.3;
				color: var(--color-text-main);
			}

			.section-copy p {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.75;
				color: #cbd5e1;
			}

			/* HERO */

			.back-link {
				display: inline-block;
				margin-bottom: 2rem;
				font-size: 0.82rem;
				font-weight: 600;
				color: #80b7f4;
				text-decoration: none;
			}

			.project-hero {
				padding-bottom: 3.5rem;
				border-bottom: 1px solid #334155;
			}

			.project-hero h1 {
				max-width: 900px;
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: clamp(2.2rem, 3.5vw, 3rem);
				line-height: 1.15;
				color: var(--color-text-main);
			}

			.project-meta {
				margin: 1.2rem 0 0;
				font-size: 0.95rem;
				color: var(--color-text-muted);
			}

			.project-summary {
				max-width: 820px;
				margin: 1.5rem 0 0;
				font-size: 1.03rem;
				line-height: 1.75;
				color: #cbd5e1;
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem;
				margin-top: 1.5rem;
			}

			.tag {
				padding: 0.35rem 0.7rem;
				border-radius: 999px;
				background: #172033;
				font-size: 0.72rem;
				color: #cbd5e1;
			}

			/* SYSTEM */

			.system-section {
				display: grid;
				grid-template-columns: 0.8fr 1.2fr;
				gap: 4rem;
				align-items: center;
				padding: 4rem 0;
				border-bottom: 1px solid #334155;
			}

			.system-visuals {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}

			.system-visuals img {
				width: 100%;
				height: auto;
				display: block;
			}

			/* PROCESSING */

			.processing-section {
				display: grid;
				grid-template-columns: 1.15fr 0.85fr;
				gap: 4rem;
				align-items: center;
				padding: 4rem 0;
				border-bottom: 1px solid #334155;
			}

			.processing-image img {
				width: 100%;
				height: auto;
				display: block;
			}

			/* RESULTS */

			.results-section {
				padding: 4rem 0;
			}

			.results-heading {
				max-width: 700px;
				margin-bottom: 1.75rem;
			}

			.results-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
				margin-bottom: 2rem;
			}

			.result-card {
				min-height: 72px;
				padding: 0.9rem 1.1rem;
				border: 1px solid #334155;
				border-radius: 10px;
				background: #111827;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.result-card span {
				margin-bottom: 0.3rem;
				font-size: 0.61rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: #94a3b8;
			}

			.result-card strong {
				font-family: var(--font-serif);
				font-size: 1.3rem;
				line-height: 1.1;
				color: var(--color-text-main);
			}

			.results-image {
				display: flex;
				justify-content: center;
			}

			.results-image img {
				width: min(100%, 760px);
				height: auto;
				display: block;
			}

			@media (max-width: 850px) {
				.project-inner {
					padding-left: 2rem;
					padding-right: 2rem;
				}

				.system-section,
				.processing-section {
					grid-template-columns: 1fr;
					gap: 2rem;
				}

				.results-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 600px) {
				.project-inner {
					padding: 3rem 1rem 4rem;
				}

				.system-visuals {
					grid-template-columns: 1fr;
				}

				.project-hero h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="project-page">
				<div class="project-inner">

					<section class="project-hero">

						<a href={url('/projects')} class="back-link">
							← Back to Projects
						</a>

						<h1>
							Oscillometric Blood Pressure Monitoring System
						</h1>

						<p class="project-meta">
							Biomedical Instrumentation · 2026
						</p>

						<p class="project-summary">
							Built an instrumentation system that acquires cuff-pressure
							signals and uses analog filtering and Python signal processing
							to estimate blood pressure.
						</p>

						<div class="tags">
							<span class="tag">Python</span>
							<span class="tag">Signal Processing</span>
							<span class="tag">Analog Circuits</span>
							<span class="tag">Instrumentation</span>
						</div>

					</section>


					<!-- SYSTEM DESIGN -->

					<section class="system-section">

						<div class="section-copy">

							<span class="label">
								System Design
							</span>

							<h2 class="section-title">
								Pressure sensing → amplification → filtering
							</h2>

							<p>
								The circuit converts cuff pressure into an electrical
								signal, amplifies it, and separates the raw pressure
								waveform from the smaller oscillometric pulse signal.
							</p>

						</div>

						<div class="system-visuals">

							<img
								src={url('/blood-pressure-schematic.png')}
								alt="Blood pressure monitoring system block diagram"
							/>

							<img
								src={url('/blood-pressure-circuit.png')}
								alt="Blood pressure instrumentation circuit"
							/>

						</div>

					</section>


					<!-- SIGNAL PROCESSING -->

					<section class="processing-section">

						<div class="processing-image">
							<img
								src={url('/blood-pressure-time-domain.png')}
								alt="Raw and filtered blood pressure signals"
							/>
						</div>

						<div class="section-copy">

							<span class="label">
								Signal Processing
							</span>

							<h2 class="section-title">
								Extracting the oscillation envelope
							</h2>

							<p>
								Python was used to isolate the useful portion of the
								signal, detect oscillations, and calculate the amplitude
								envelope used to estimate arterial pressure.
							</p>

						</div>

					</section>


					<!-- RESULTS -->

					<section class="results-section">

						<div class="results-heading">

							<span class="label">
								Estimated Blood Pressure
							</span>

							<h2 class="section-title">
								Systolic, MAP, and diastolic pressure
							</h2>

						</div>

						<div class="results-grid">

							<div class="result-card">
								<span>Systolic</span>
								<strong>135.7 mmHg</strong>
							</div>

							<div class="result-card">
								<span>Mean Arterial Pressure</span>
								<strong>89.3 mmHg</strong>
							</div>

							<div class="result-card">
								<span>Diastolic</span>
								<strong>70.4 mmHg</strong>
							</div>

						</div>

						<div class="results-image">
							<img
								src={url('/blood-pressure-results.png')}
								alt="Final oscillometric blood pressure analysis"
							/>
						</div>

					</section>

				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
