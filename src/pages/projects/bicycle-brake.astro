---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { url } from '../../utils/paths';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Bicycle Caliper Brake Design | ${SITE_TITLE}`}
			description="Design, optimization, prototyping, and testing of a lightweight bicycle caliper brake."
		/>

		<style>
			main {
				max-width: none;
				padding: 0;
				background: #050814;
			}

			.project-page {
				min-height: 100vh;
				background:
					radial-gradient(
						ellipse at 18% 5%,
						rgba(49, 70, 105, 0.22),
						transparent 50%
					),
					#050814;
			}

			.project-inner {
				max-width: 1100px;
				margin: 0 auto;
				padding: 4rem 0 6rem;
			}

			.label {
				display: block;
				margin-bottom: 0.75rem;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.13em;
				text-transform: uppercase;
				color: #94a3b8;
			}

			.section-title {
				display: block;
				margin: 0 0 1rem;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.6rem;
				line-height: 1.3;
				color: var(--color-text-main);
			}

			.section-copy p {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.75;
				color: #cbd5e1;
			}

			.project-image img {
				width: 100%;
				height: auto;
				display: block;
			}

			/* HERO */

			.back-link {
				display: inline-block;
				margin-bottom: 2rem;
				font-size: 0.82rem;
				font-weight: 600;
				color: #80b7f4;
				text-decoration: none;
			}

			.project-hero {
				padding-bottom: 3.5rem;
				border-bottom: 1px solid #334155;
			}

			.project-hero h1 {
				max-width: 900px;
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: clamp(2.2rem, 3.5vw, 3rem);
				line-height: 1.15;
				color: var(--color-text-main);
			}

			.project-meta {
				margin: 1.2rem 0 0;
				font-size: 0.95rem;
				color: var(--color-text-muted);
			}

			.project-summary {
				max-width: 820px;
				margin: 1.5rem 0 0;
				font-size: 1.03rem;
				line-height: 1.75;
				color: #cbd5e1;
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem;
				margin-top: 1.5rem;
			}

			.tag {
				padding: 0.35rem 0.7rem;
				border-radius: 999px;
				background: #172033;
				font-size: 0.72rem;
				color: #cbd5e1;
			}

			/* DESIGN + OPTIMIZATION */

			.design-section {
				padding: 4rem 0;
				border-bottom: 1px solid #334155;
			}

			.design-heading {
				max-width: 720px;
				margin-bottom: 2rem;
			}

			.design-visuals {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}

			.design-visuals img {
				width: 100%;
				height: auto;
				display: block;
			}

			/* PROTOTYPE */

			.prototype-section {
				display: grid;
				grid-template-columns: 1.05fr 0.95fr;
				gap: 4rem;
				align-items: center;
				padding: 4rem 0;
				border-bottom: 1px solid #334155;
			}

			.iteration-stat {
				margin-top: 1.4rem;
				padding-left: 1rem;
				border-left: 2px solid #80b7f4;
			}

			.iteration-stat strong {
				display: block;
				font-family: var(--font-serif);
				font-size: 1.45rem;
				color: var(--color-text-main);
			}

			.iteration-stat span {
				display: block;
				margin-top: 0.2rem;
				font-size: 0.75rem;
				color: var(--color-text-muted);
			}

			/* RESULTS */

			.results-section {
				padding: 4rem 0;
			}

			.results-heading {
				margin-bottom: 1.75rem;
			}

			.results-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
				margin-bottom: 2rem;
			}

			.result-card {
				min-height: 72px;
				padding: 0.9rem 1.1rem;
				border: 1px solid #334155;
				border-radius: 10px;
				background: #111827;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.result-card span {
				margin-bottom: 0.3rem;
				font-size: 0.61rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: #94a3b8;
			}

			.result-card strong {
				font-family: var(--font-serif);
				font-size: 1.3rem;
				color: var(--color-text-main);
			}

			.final-image {
				display: flex;
				justify-content: center;
			}

			.final-image img {
				width: min(100%, 760px);
				height: auto;
				display: block;
			}

			@media (max-width: 850px) {
				.project-inner {
					padding-left: 2rem;
					padding-right: 2rem;
				}

				.design-visuals,
				.prototype-section {
					grid-template-columns: 1fr;
				}

				.results-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 600px) {
				.project-inner {
					padding: 3rem 1rem 4rem;
				}

				.project-hero h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="project-page">
				<div class="project-inner">

					<!-- HERO -->

					<section class="project-hero">

						<a href={url('/projects')} class="back-link">
							← Back to Projects
						</a>

						<h1>
							Bicycle Caliper Brake Design
						</h1>

						<p class="project-meta">
							Mechanical Design · FEA & Topology Lead · 2026
						</p>

						<p class="project-summary">
							Designed, optimized, manufactured, and tested a lightweight
							bicycle caliper brake using FEA, topology optimization, and
							iterative physical testing.
						</p>

						<div class="tags">
							<span class="tag">SolidWorks</span>
							<span class="tag">FEA</span>
							<span class="tag">Topology Optimization</span>
							<span class="tag">Prototyping</span>
						</div>

					</section>


					<!-- DESIGN + OPTIMIZATION -->

					<section class="design-section">

						<div class="design-heading">

							<span class="label">
								Design + Optimization
							</span>

							<h2 class="section-title">
								Using simulation to guide material and geometry
							</h2>

							<div class="section-copy">
								<p>
									Topology optimization identified efficient load paths
									while preserving material around the pivot, cable
									attachment, and brake-pad interfaces. FEA was then used
									to evaluate stress and deflection through each iteration.
								</p>
							</div>

						</div>

						<div class="design-visuals">

							<img
								src={url('/brake-topology.png')}
								alt="Topology optimization of bicycle brake calipers"
							/>

							<img
								src={url('/brake-fea-optimized.png')}
								alt="Finite element analysis of optimized bicycle brake calipers"
							/>

						</div>

					</section>


					<!-- PROTOTYPE + ITERATION -->

					<section class="prototype-section">

						<div class="project-image">
							<img
								src={url('/brake-prototype.png')}
								alt="SLS Nylon bicycle brake prototype"
							/>
						</div>

						<div class="section-copy">

							<span class="label">
								Prototype + Iteration
							</span>

							<h2 class="section-title">
								Testing revealed a stiffness problem
							</h2>

							<p>
								The SLS Nylon 12 prototype showed excessive deflection
								in the right caliper, reducing effective engagement of
								the opposite brake pad. Reinforcing the primary load path
								produced a stiffer and more balanced mechanism.
							</p>

							<div class="iteration-stat">
								<strong>~8 mm → ~3 mm</strong>
								<span>
									Predicted right-caliper deflection after redesign
								</span>
							</div>

						</div>

					</section>


					<!-- FINAL PROTOTYPE -->

					<section class="results-section">

						<div class="results-heading">

							<span class="label">
								Final Prototype
							</span>

							<h2 class="section-title">
								A lightweight, functional final design
							</h2>

						</div>

						<div class="results-grid">

							<div class="result-card">
								<span>Mass</span>
								<strong>96 g</strong>
							</div>

							<div class="result-card">
								<span>Stopping Distance</span>
								<strong>13.4 m</strong>
							</div>

							<div class="result-card">
								<span>Combined Deflection</span>
								<strong>6 mm</strong>
							</div>

						</div>

						<div class="final-image">
							<img
								src={url('/brake-final.png')}
								alt="Final manufactured bicycle caliper brake"
							/>
						</div>

					</section>

				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
