---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { url } from '../../utils/paths';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Bicycle Caliper Brake Design | ${SITE_TITLE}`}
			description="Design, optimization, prototyping, and testing of a lightweight bicycle caliper brake."
		/>

		<style>
			main {
				max-width: none;
				padding: 0;
				background: #050814;
			}

			.project-page {
				min-height: 100vh;
				background:
					radial-gradient(
						ellipse at 18% 5%,
						rgba(49, 70, 105, 0.22),
						transparent 50%
					),
					#050814;
			}

			.project-inner {
				max-width: 1100px;
				margin: 0 auto;
				padding: 4rem 0 6rem;
			}

			.label {
				display: block;
				margin-bottom: 0.75rem;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.13em;
				text-transform: uppercase;
				color: #94a3b8;
			}

			.section-title {
				display: block;
				margin: 0 0 1rem;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.65rem;
				color: var(--color-text-main);
			}

			.section-copy p {
				margin: 0 0 0.9rem;
				font-size: 0.95rem;
				line-height: 1.75;
				color: #cbd5e1;
			}

			.section-copy p:last-child {
				margin-bottom: 0;
			}

			/* HERO */

			.back-link {
				display: inline-block;
				margin-bottom: 2rem;
				font-size: 0.82rem;
				font-weight: 600;
				color: #80b7f4;
				text-decoration: none;
			}

			.project-hero {
				padding-bottom: 3.5rem;
				border-bottom: 1px solid #334155;
			}

			.project-hero h1 {
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: clamp(2.2rem, 3.5vw, 3rem);
				color: var(--color-text-main);
			}

			.project-meta {
				margin: 1.2rem 0 0;
				font-size: 0.95rem;
				color: var(--color-text-muted);
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem;
				margin-top: 1.5rem;
			}

			.tag {
				padding: 0.35rem 0.7rem;
				border-radius: 999px;
				background: #172033;
				font-size: 0.72rem;
				color: #cbd5e1;
			}

			/* OVERVIEW + PROBLEM */

			.text-section {
				display: grid;
				grid-template-columns: 180px minmax(0, 1fr);
				gap: 4rem;
				padding: 3.5rem 0;
				border-bottom: 1px solid #334155;
			}

			.text-section h2 {
				display: block;
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.45rem;
				color: var(--color-text-main);
			}

			/* PROCESS */

			.process-section {
				padding: 4rem 0;
				border-bottom: 1px solid #334155;
			}

			.process-heading {
				margin-bottom: 2.5rem;
			}

			.process-step {
				display: grid;
				grid-template-columns: 0.85fr 1.15fr;
				gap: 4rem;
				align-items: center;
				margin-bottom: 4rem;
			}

			.process-step.reverse {
				grid-template-columns: 1.15fr 0.85fr;
			}

			.process-step:last-child {
				margin-bottom: 0;
			}

			.process-image {
				display: flex;
				justify-content: center;
				align-items: center;
			}

			.process-image img {
				width: 100%;
				height: auto;
				display: block;
			}

			/* Keep topology image large but controlled */
			.topology-image img {
				width: min(100%, 620px);
				height: auto;
				object-fit: contain;
			}


.prototype-image img {
	width: min(100%, 430px);
	height: auto;
	object-fit: contain;
}

			.iteration-stat {
				margin-top: 1.3rem;
				padding-left: 1rem;
				border-left: 2px solid #80b7f4;
			}

			.iteration-stat strong {
				display: block;
				font-family: var(--font-serif);
				font-size: 1.45rem;
				color: var(--color-text-main);
			}

			.iteration-stat span {
				font-size: 0.75rem;
				color: var(--color-text-muted);
			}

			/* RESULTS */

			.results-section {
				padding: 4rem 0 0;
			}

			.results-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
				margin: 1.75rem 0 2rem;
			}

			.result-card {
				min-height: 72px;
				padding: 0.9rem 1.1rem;
				border: 1px solid #334155;
				border-radius: 10px;
				background: #111827;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.result-card span {
				margin-bottom: 0.3rem;
				font-size: 0.61rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: #94a3b8;
			}

			.result-card strong {
				font-family: var(--font-serif);
				font-size: 1.3rem;
				color: var(--color-text-main);
			}

			.final-image {
				display: flex;
				justify-content: center;
			}

			.final-image img {
				width: min(100%, 760px);
				height: auto;
				display: block;
			}

			/* MOBILE */

			@media (max-width: 850px) {
				.project-inner {
					padding-left: 2rem;
					padding-right: 2rem;
				}

				.text-section,
				.process-step,
				.process-step.reverse {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}

				.results-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 600px) {
				.project-inner {
					padding: 3rem 1rem 4rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="project-page">
				<div class="project-inner">

					<!-- HERO -->

					<section class="project-hero">

						<a href={url('/projects')} class="back-link">
							← Back to Projects
						</a>

						<h1>Bicycle Caliper Brake Design</h1>

						<p class="project-meta">
							Mechanical Design · FEA & Topology Lead · 2026
						</p>

						<div class="tags">
							<span class="tag">SolidWorks</span>
							<span class="tag">FEA</span>
							<span class="tag">Topology Optimization</span>
							<span class="tag">Mechanical Analysis</span>
							<span class="tag">Prototyping</span>
						</div>

					</section>


					<!-- OVERVIEW -->

					<section class="text-section">

						<h2>Overview</h2>

						<div class="section-copy">
							<p>
								Designed, optimized, manufactured, and tested a
								lightweight bicycle caliper brake through modeling, finite element analysis, topology optimization,
								and prototyping. I was the team's FEA and topology lead, focusing on
								structural performance and material-efficient geometry.
							</p>
						</div>

					</section>


					<!-- PROBLEM -->

					<section class="text-section">

						<h2>Problem</h2>

						<div class="section-copy">
							<p>
								The brake needed to remain lightweight while safely
								transmitting braking loads with little stress and
								deflection. Its geometry also had to fit around the wheel,
								frame, mounting locations, cable, and brake pads.
							</p>
						</div>

					</section>


					<!-- PROCESS -->

					<section class="process-section">

						<div class="process-heading">
							<span class="label">Process</span>

							<h2 class="section-title">
								Analysis, optimization, and physical iteration
							</h2>
						</div>


						<!-- STEP 1 -->

						<div class="process-step">

							<div class="section-copy">
								<span class="label">
									01 · Structural Analysis
								</span>

								<h2 class="section-title">
									Establishing loads and identifying weak regions
								</h2>

								<p>
									Hand calculations were used to estimate braking loads,
									cable tension, stress, and deflection before the CAD
									geometry was evaluated with FEA. Initial simulations revealed stress concentrations
									and excessive deformation around abrupt geometry
									transitions and mounting regions.
								</p>
							</div>

							<div class="process-image">
								<img
									src={url('/brake-concept.png')}
									alt="Initial bicycle brake design"
								/>
							</div>

						</div>


						<!-- STEP 2 -->

						<div class="process-step reverse">

							<div class="process-image topology-image">
								<img
									src={url('/brake-topology.png')}
									alt="Topology optimization of bicycle brake caliper"
								/>
							</div>

							<div class="section-copy">
								<span class="label">
									02 · Optimization
								</span>

								<h2 class="section-title">
									Using load paths to shape the geometry
								</h2>

								<p>
									Topology optimization removed material from low-stress
									regions while retaining structural material around the
									pivots, cable attachment, and brake-pad interfaces.
								</p>

								<p>
									The resulting geometry was then
									re-evaluated using FEA to optimize stiffness,
									strength, and mass.
								</p>
							</div>

						</div>


						<!-- STEP 3 -->

						<div class="process-step">

							<div class="section-copy">
								<span class="label">
									03 · Prototype + Redesign
								</span>

								<h2 class="section-title">
									Testing revealed a stiffness problem
								</h2>

								<p>
									The SLS Nylon 12 prototype showed that the right
									caliper deflected too much, preventing the opposite pad
									from engaging effectively. Reinforcing its primary load path improved force
									transfer and reduced the predicted right-caliper deflection.
								</p>

								<div class="iteration-stat">
									<strong>~8 mm → ~3 mm</strong>
									<span>
										Predicted right-caliper deflection after redesign
									</span>
								</div>
							</div>

							<div class="process-image prototype-image">
	<img
		src={url('/brake-prototype.png')}
		alt="Printed bicycle brake prototype"
	/>
</div>

						</div>

					</section>


					<!-- RESULTS -->

					<section class="results-section">

						<span class="label">Results</span>

						<h2 class="section-title">
							Final manufactured prototype
						</h2>

						<div class="results-grid">

							<div class="result-card">
								<span>Mass</span>
								<strong>96 g</strong>
							</div>

							<div class="result-card">
								<span>Stopping Distance</span>
								<strong>13.4 m</strong>
							</div>

							<div class="result-card">
								<span>Combined Deflection</span>
								<strong>6 mm</strong>
							</div>

						</div>

						<div class="final-image">
							<img
								src={url('/brake-final.png')}
								alt="Final bicycle brake prototype"
							/>
						</div>

					</section>

				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
