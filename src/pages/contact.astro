---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, CV_URL } from '../consts';
import { url } from '../utils/paths';

const cvHref = CV_URL ? url(CV_URL) : null;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Contact | ${SITE_TITLE}`}
			description="Get in touch with Nadia Lotfi."
		/>

		<style>
			main {
				max-width: none;
				padding: 0;
				background: #050814;
			}

			.contact-page {
				min-height: calc(100vh - 8.5rem);
				background:
					radial-gradient(
						ellipse at 18% 8%,
						rgba(49, 70, 105, 0.25) 0%,
						transparent 50%
					),
					#050814;
			}

			.contact-inner {
				max-width: 1100px;
				margin: 0 auto;
				padding: 4.5rem 0 6rem;
			}

			.contact-header {
				padding-bottom: 2rem;
				border-bottom: 1px solid #334155;
			}

			.contact-header h1 {
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: clamp(2rem, 3vw, 2.6rem);
				font-weight: 700;
				color: var(--color-text-main);
			}

			.contact-header p {
				max-width: 650px;
				margin: 1rem 0 0;
				font-size: 1rem;
				line-height: 1.7;
				color: var(--color-text-muted);
			}

			.contact-content {
				max-width: 720px;
				padding-top: 3rem;
			}

			.contact-list {
				display: grid;
				gap: 1rem;
			}

			.contact-item {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 2rem;
				padding: 1.2rem 0;
				border-bottom: 1px solid #334155;
			}

			.contact-label {
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #64748b;
			}

			.contact-value {
				font-size: 0.95rem;
				color: var(--color-text-main);
				text-decoration: none;
			}

			.contact-value:hover {
				color: #80b7f4;
				text-decoration: none;
			}

			.contact-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 2rem;
			}

			.contact-button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 46px;
				padding: 0.65rem 1.2rem;
				border: 1px solid #334155;
				border-radius: 999px;
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--color-text-main);
				text-decoration: none;
				background: transparent;
			}

			.contact-button:hover {
				border-color: #80b7f4;
				color: #a7cffb;
				text-decoration: none;
			}

			.contact-button.primary {
				background: #80b7f4;
				border-color: #80b7f4;
				color: #07101f;
			}

			.contact-button.primary:hover {
				background: #9bc7f8;
				border-color: #9bc7f8;
				color: #07101f;
			}

			@media (max-width: 800px) {
				.contact-inner {
					padding-left: 2rem;
					padding-right: 2rem;
				}
			}

			@media (max-width: 600px) {
				.contact-inner {
					padding: 3rem 1rem 4rem;
				}

				.contact-item {
					align-items: flex-start;
					flex-direction: column;
					gap: 0.35rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="contact-page">
				<div class="contact-inner">

					<section class="contact-header">
						<h1>Contact</h1>

						<p>
							I’m always happy to connect about research, engineering,
							design, or potential opportunities.
						</p>
					</section>

					<div class="contact-content">
						<div class="contact-list">

							<div class="contact-item">
								<span class="contact-label">Email</span>

								<a
									href="mailto:nadialotfi2028@u.northwestern.edu"
									class="contact-value"
								>
									nadialotfi2028@u.northwestern.edu
								</a>
							</div>

							<div class="contact-item">
								<span class="contact-label">LinkedIn</span>

								<a
									href="https://www.linkedin.com/in/nadia-lotfi"
									target="_blank"
									rel="noopener noreferrer"
									class="contact-value"
								>
									linkedin.com/in/nadia-lotfi ↗
								</a>
							</div>

							<div class="contact-item">
								<span class="contact-label">Phone</span>

								<a
									href="tel:+18472579403"
									class="contact-value"
								>
									(847) 257-9403
								</a>
							</div>
						</div>

						<div class="contact-actions">
							<a
								href="mailto:nadialotfi2028@u.northwestern.edu"
								class="contact-button primary"
							>
								Send Email
							</a>

							{cvHref && (
								<a
									href={cvHref}
									target="_blank"
									rel="noopener noreferrer"
									class="contact-button"
								>
									View Resume ↗
								</a>
							)}
						</div>
					</div>

				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
