---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { url } from '../utils/paths';

const projects = [
	{
		title: 'Oscillometric Blood Pressure Monitoring System',
		category: 'Biomedical Instrumentation',
		description:
			'Designed an instrumentation system for non-invasive blood pressure measurement using analog circuitry and physiological signal processing.',
		skills: ['Python', 'Signal Processing', 'Analog Circuits', 'Instrumentation'],
		image: '/blood-pressure-circuit.png',
		link: '/projects/blood-pressure',
		imageClass: 'blood-pressure-cover',
	},
	{
		title: 'Bicycle Caliper Brake Design',
		category: 'Mechanical Design',
		description:
			'Designed, optimized, manufactured, and tested a lightweight bicycle braking system using simulations and iterative prototyping.',
		skills: ['FEA', 'Topology Optimization', 'CAD', 'Prototyping'],
		image: '/caliper.png',
		link: '/projects/bicycle-brake',
		imageClass: '',
	},
	{
		title: 'Legacy PopUp Display',
		category: 'Product Design',
		description:
			'A portable, modular exhibition system designed to protect and present historical media.',
		skills: ['Fabrication', 'Product Design', 'Teamwork'],
		image: '/legacy-final.png',
		link: '/projects/legacy-popup',
		imageClass: '',
	},
	{
		title: 'Once Upon a Tile',
		category: 'Robotics + Accessible Design',
		description:
			'An interactive robotics system designed around accessible and intuitive creative learning.',
		skills: ['Robotics', 'Prototyping', 'Accessible Design'],
		image: '/once.png',
		link: '/projects/once-upon-a-tile',
		imageClass: '',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Projects | ${SITE_TITLE}`}
			description="Selected engineering, biomedical, and design projects."
		/>

		<style>
			main {
				max-width: none;
				padding: 0;
				background: #050814;
			}

			.projects-page {
				min-height: 100vh;
				background:
					radial-gradient(
						ellipse at 18% 5%,
						rgba(49, 70, 105, 0.25),
						transparent 50%
					),
					#050814;
			}

			.projects-inner {
				max-width: 1100px;
				margin: 0 auto;
				padding: 4.5rem 0 6rem;
			}

			.page-header {
				padding-bottom: 2rem;
				border-bottom: 1px solid #334155;
			}

			.page-header h1 {
				margin: 0;
				font-family: var(--font-serif);
				font-size: clamp(2rem, 3vw, 2.6rem);
				font-weight: 700;
				color: var(--color-text-main);
			}

			.page-header p {
				max-width: 650px;
				margin: 1rem 0 0;
				font-size: 1rem;
				line-height: 1.7;
				color: var(--color-text-muted);
			}

			.project-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5rem;
				padding-top: 3rem;
			}

			.project-card {
				display: flex;
				flex-direction: column;
				overflow: hidden;
				border: 1px solid #334155;
				border-radius: 16px;
				background: rgba(15, 23, 42, 0.45);
			}

			.project-image {
				aspect-ratio: 16 / 9;
				width: 100%;
				overflow: hidden;
				background:
					linear-gradient(
						135deg,
						#172033,
						#0b1020
					);
				border-bottom: 1px solid #334155;
			}

			.project-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			/* Blood-pressure schematic: show full image, don't crop it */
			.project-image img.blood-pressure-cover {
				object-fit: contain;
				object-position: center;
				background: #e5e5e5;
			}

			.image-placeholder {
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #64748b;
			}

			.project-content {
				display: flex;
				flex-direction: column;
				flex: 1;
				padding: 1.5rem;
			}

			.project-category {
				margin-bottom: 0.65rem;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.13em;
				text-transform: uppercase;
				color: #80b7f4;
			}

			.project-card h2 {
				display: block;
				margin: 0 0 0.8rem;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.4rem;
				color: var(--color-text-main);
			}

			.project-description {
				margin: 0 0 1.25rem;
				font-size: 0.92rem;
				line-height: 1.7;
				color: var(--color-text-muted);
			}

			.skills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				margin-bottom: 1.5rem;
			}

			.skill {
				padding: 0.3rem 0.65rem;
				border: 1px solid #334155;
				border-radius: 999px;
				font-size: 0.72rem;
				color: #cbd5e1;
			}

			.view-project {
				margin-top: auto;
				font-size: 0.88rem;
				font-weight: 600;
				color: #80b7f4;
				text-decoration: none;
			}

			.view-project:hover {
				color: #a7cffb;
				text-decoration: none;
			}

			@media (max-width: 800px) {
				.projects-inner {
					padding-left: 2rem;
					padding-right: 2rem;
				}

				.project-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 600px) {
				.projects-inner {
					padding: 3rem 1rem 4rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="projects-page">
				<div class="projects-inner">

					<section class="page-header">
						<h1>Projects</h1>
						<p>
							Engineering design work from early concepts through prototyping and testing.
						</p>
					</section>

					<div class="project-grid">
						{projects.map((project) => (
							<article class="project-card">

								<div class="project-image">
									{project.image ? (
										<img
											src={url(project.image)}
											alt={project.title}
											class={project.imageClass}
										/>
									) : (
										<div class="image-placeholder">
											Add Project Image
										</div>
									)}
								</div>

								<div class="project-content">
									<span class="project-category">
										{project.category}
									</span>

									<h2>{project.title}</h2>

									<p class="project-description">
										{project.description}
									</p>

									<div class="skills">
										{project.skills.map((skill) => (
											<span class="skill">{skill}</span>
										))}
									</div>

									<a
										href={url(project.link)}
										class="view-project"
									>
										View Project →
									</a>
								</div>

							</article>
						))}
					</div>

				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
