---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Creative Practice | ${SITE_TITLE}`}
			description="Ceramics, sketching, visual design, and the creative practices that shape how I approach engineering."
		/>

		<style>
			main {
				max-width: none;
				padding: 0;
				background: #050814;
			}

			.creative-page {
				min-height: 100vh;
				background:
					radial-gradient(
						ellipse at 18% 5%,
						rgba(49, 70, 105, 0.22),
						transparent 50%
					),
					radial-gradient(
						ellipse at 82% 28%,
						rgba(35, 50, 78, 0.12),
						transparent 45%
					),
					#050814;
			}

			.creative-inner {
				max-width: 1100px;
				margin: 0 auto;
				padding: 4.5rem 0 6rem;
			}

			/* =========================
			   SHARED
			   ========================= */

			.eyebrow {
				display: block;
				margin-bottom: 0.9rem;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: #80b7f4;
			}

			.image-placeholder {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 1rem;
				text-align: center;
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #64748b;
			}

			/* =========================
			   TOP SECTION
			   ========================= */

			.creative-hero {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 380px;
				gap: 5rem;
				align-items: center;
				padding-bottom: 4.5rem;
			}

			.creative-copy {
				max-width: 680px;
			}

			.creative-copy h1 {
				margin: 0 0 1.5rem;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: clamp(2.1rem, 3.5vw, 3rem);
				line-height: 1.18;
				color: var(--color-text-main);
			}

			.creative-copy p {
				margin: 0 0 1rem;
				font-size: 0.96rem;
				line-height: 1.8;
				color: var(--color-text-muted);
			}

			.creative-copy p:last-of-type {
				margin-bottom: 0;
			}

			.practice-line {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.7rem;
				margin-top: 1.75rem;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: #cbd5e1;
			}

			.practice-line .arrow {
				color: #80b7f4;
			}

			.hero-image {
				position: relative;
				width: 100%;
				aspect-ratio: 4 / 5;
				overflow: hidden;
				border: 1px solid #334155;
				border-radius: 16px;
				background:
					linear-gradient(
						135deg,
						#172033,
						#0b1020
					);
			}

			.hero-image img {
				width: 100%;
				height: 100%;
				display: block;
				object-fit: cover;
			}

			/* =========================
			   GALLERY
			   ========================= */

			.gallery-section {
				padding: 4.5rem 0;
				border-top: 1px solid #334155;
			}

			.section-heading {
				margin-bottom: 2rem;
			}

			.section-heading h2 {
				display: block;
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.6rem;
				color: var(--color-text-main);
			}

			.art-gallery {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				grid-auto-rows: 260px;
				gap: 1rem;
			}

			.gallery-image {
				position: relative;
				overflow: hidden;
				border: 1px solid #334155;
				border-radius: 14px;
				background:
					linear-gradient(
						135deg,
						#172033,
						#0b1020
					);
			}

			.gallery-image-large {
				grid-row: span 2;
			}

			.gallery-image-wide {
				grid-column: span 2;
			}

			.gallery-image img {
				width: 100%;
				height: 100%;
				display: block;
				object-fit: cover;
			}

			/* =========================
			   REFLECTION
			   ========================= */

			.reflection {
				padding: 4rem 0 1rem;
				border-top: 1px solid #334155;
			}

			.reflection-content {
				display: grid;
				grid-template-columns: 0.7fr 1.3fr;
				gap: 5rem;
			}

			.reflection h2 {
				display: block;
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.65rem;
				line-height: 1.3;
				color: var(--color-text-main);
			}

			.reflection-copy p {
				margin: 0 0 1rem;
				font-size: 0.93rem;
				line-height: 1.8;
				color: var(--color-text-muted);
			}

			.reflection-copy p:last-child {
				margin-bottom: 0;
			}

			/* =========================
			   RESPONSIVE
			   ========================= */

			@media (max-width: 850px) {
				.creative-inner {
					padding-left: 2rem;
					padding-right: 2rem;
				}

				.creative-hero {
					grid-template-columns: 1fr;
					gap: 2.5rem;
				}

				.hero-image {
					max-width: 480px;
					aspect-ratio: 4 / 3;
				}

				.art-gallery {
					grid-template-columns: repeat(2, 1fr);
				}

				.reflection-content {
					grid-template-columns: 1fr;
					gap: 1.25rem;
				}
			}

			@media (max-width: 600px) {
				.creative-inner {
					padding: 3rem 1rem 4rem;
				}

				.creative-hero {
					padding-bottom: 3rem;
				}

				.creative-copy h1 {
					font-size: 2rem;
				}

				.practice-line {
					gap: 0.5rem;
				}

				.gallery-section {
					padding: 3rem 0;
				}

				.art-gallery {
					grid-template-columns: 1fr;
					grid-auto-rows: 320px;
				}

				.gallery-image-large,
				.gallery-image-wide {
					grid-row: auto;
					grid-column: auto;
				}

				.reflection {
					padding-top: 3rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="creative-page">
				<div class="creative-inner">

					<!-- ========================================
					     1. MAKING + ENGINEERING
					     ======================================== -->

					<section class="creative-hero">

						<div class="creative-copy">
							<span class="eyebrow">
								Creative Practice
							</span>

							<h1>
								Making, testing, and learning
							</h1>

							<p>
								Art and engineering are built on many of the same habits, shaped by observation, prototyping, testing, and refinement. 
							</p>

							<p>
								I’ve learned a lot from ideas that looked good on paper but changed once they encountered real materials, real constraints, or real people. Those moments have made me more willing to question assumptions, pay attention to detail, and treat iteration as an essential part of the process. Whether I’m working in ceramics, creating a prototype, or designing, I’m most interested in thoughtful, human-centered design that is truly helpful for the people it is made for.
							</p>

							<div class="practice-line">
								<span>Observe</span>
								<span class="arrow">→</span>
								<span>Prototype</span>
								<span class="arrow">→</span>
								<span>Test</span>
								<span class="arrow">→</span>
								<span>Refine</span>
							</div>
						</div>

						<div class="hero-image">
							<img
								src="/ceramics1.jpg"
								alt="coverceramics.jpeg"
							/>
						</div>

					</section>


					<!-- ========================================
					     2. ART + CERAMICS GALLERY
					     ======================================== -->

					<section class="gallery-section">

						<div class="section-heading">
							<span class="eyebrow">
								Selected Work
							</span>

							<h2>
								Ceramics & visual studies
							</h2>
						</div>

						<div class="art-gallery">

							<div class="gallery-image gallery-image-large">
								<div class="image-placeholder">
									Ceramics
								</div>
							</div>

							<div class="gallery-image">
								<div class="image-placeholder">
									Sketch
								</div>
							</div>

							<div class="gallery-image">
								<div class="image-placeholder">
									Ceramic Detail
								</div>
							</div>

							<div class="gallery-image">
								<div class="image-placeholder">
									Sketch / Study
								</div>
							</div>

							<div class="gallery-image">
								<div class="image-placeholder">
									Ceramics
								</div>
							</div>

							<div class="gallery-image gallery-image-wide">
								<div class="image-placeholder">
									Process / Visual Study
								</div>
							</div>

						</div>
					</section>

				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
