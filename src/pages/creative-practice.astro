---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Creative Practice | ${SITE_TITLE}`}
			description="Ceramics, sketching, visual design, and the creative practices that shape how I approach engineering."
		/>

		<style>
			main {
				max-width: none;
				padding: 0;
				background: #050814;
			}

			.creative-page {
				min-height: 100vh;
				background:
					radial-gradient(
						ellipse at 18% 5%,
						rgba(49, 70, 105, 0.22),
						transparent 50%
					),
					radial-gradient(
						ellipse at 82% 28%,
						rgba(35, 50, 78, 0.12),
						transparent 45%
					),
					#050814;
			}

			.creative-inner {
				max-width: 1100px;
				margin: 0 auto;
				padding: 4rem 0 5rem;
			}

			/* =========================
			   SHARED
			   ========================= */

			.eyebrow {
				display: block;
				margin-bottom: 0.8rem;
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: #80b7f4;
			}

			/* =========================
			   TOP SECTION
			   ========================= */

			.creative-hero {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 320px;
				gap: 4rem;
				align-items: center;
				padding-bottom: 3.5rem;
			}

			.creative-copy {
				max-width: 680px;
			}

			.creative-copy h1 {
				margin: 0 0 1.25rem;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: clamp(2rem, 3vw, 2.65rem);
				line-height: 1.15;
				color: var(--color-text-main);
			}

			.creative-copy p {
				margin: 0 0 0.9rem;
				font-size: 0.94rem;
				line-height: 1.75;
				color: var(--color-text-muted);
			}

			.practice-line {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.6rem;
				margin-top: 1.4rem;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.07em;
				text-transform: uppercase;
				color: #cbd5e1;
			}

			.practice-line .arrow {
				color: #80b7f4;
			}

			.hero-image {
				width: 100%;
				aspect-ratio: 4 / 5;
				overflow: hidden;
				border: 1px solid #334155;
				border-radius: 14px;
				background: #111827;
			}

			.hero-image img {
				width: 100%;
				height: 100%;
				display: block;
				object-fit: cover;
			}

			/* =========================
			   COLLAGE
			   ========================= */

			.gallery-section {
				padding: 3.5rem 0;
				border-top: 1px solid #334155;
			}

			.section-heading {
				margin-bottom: 1.5rem;
			}

			.section-heading h2 {
				display: block;
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.5rem;
				color: var(--color-text-main);
			}

			.art-gallery {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				grid-auto-rows: 65px;
				grid-auto-flow: dense;
				gap: 0.7rem;
			}

			.gallery-image {
				overflow: hidden;
				border: 1px solid #334155;
				border-radius: 12px;
				background: #0b1020;
			}

			.gallery-image img {
				width: 100%;
				height: 100%;
				display: block;
			}

			/* 1 — ceramic mugs */
			.item-1 {
				grid-column: 1;
				grid-row: span 5;
			}

			.item-1 img {
				object-fit: cover;
			}

			/* 2 — wide outdoor sketch */
			.item-2 {
				grid-column: 2 / 4;
				grid-row: span 3;
			}

			.item-2 img {
				object-fit: contain;
				background: #f3f3f1;
			}

			/* 3 — blue vessel */
			.item-3 {
				grid-column: 4;
				grid-row: span 5;
			}

			.item-3 img {
				object-fit: cover;
			}

			/* 4 — food sketch */
			.item-4 {
				grid-column: 1;
				grid-row: span 6;
			}

			.item-4 img {
				object-fit: contain;
				background: #f3f3f1;
			}

			/* 5 — hands sketch */
			.item-5 {
				grid-column: 2;
				grid-row: span 5;
			}

			.item-5 img {
				object-fit: contain;
				background: #f3f3f1;
			}

			/* 6 — cat sketch */
			.item-6 {
				grid-column: 3;
				grid-row: span 5;
			}

			.item-6 img {
				object-fit: contain;
				background: #f3f3f1;
			}

			/* 7 — ceramic bowl */
			.item-7 {
				grid-column: 4;
				grid-row: span 6;
			}

			.item-7 img {
				object-fit: cover;
			}

			/* 8 + 9 — paintings lower in the collage */
			.item-8 {
				grid-column: 2;
				grid-row: span 6;
			}

			.item-9 {
				grid-column: 3;
				grid-row: span 6;
			}

			.item-8 img,
			.item-9 img {
				object-fit: contain;
				background: #0b1020;
			}

			/* =========================
			   REFLECTION
			   ========================= */

			.reflection {
				padding: 3.5rem 0 0;
				border-top: 1px solid #334155;
			}

			.reflection-content {
				display: grid;
				grid-template-columns: 0.7fr 1.3fr;
				gap: 4rem;
			}

			.reflection h2 {
				display: block;
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.55rem;
				line-height: 1.3;
				color: var(--color-text-main);
			}

			.reflection-copy {
				max-width: 620px;
			}

			.reflection-copy p {
				margin: 0 0 0.9rem;
				font-size: 0.9rem;
				line-height: 1.75;
				color: var(--color-text-muted);
			}

			/* =========================
			   RESPONSIVE
			   ========================= */

			@media (max-width: 850px) {
				.creative-inner {
					padding-left: 2rem;
					padding-right: 2rem;
				}

				.creative-hero {
					grid-template-columns: 1fr;
					gap: 2rem;
				}

				.hero-image {
					max-width: 420px;
					aspect-ratio: 4 / 3;
				}

				.art-gallery {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					grid-auto-rows: auto;
				}

				.item-1,
				.item-2,
				.item-3,
				.item-4,
				.item-5,
				.item-6,
				.item-7,
				.item-8,
				.item-9 {
					grid-column: auto;
					grid-row: auto;
				}

				.item-1,
				.item-3,
				.item-4,
				.item-5,
				.item-6,
				.item-8,
				.item-9 {
					aspect-ratio: 3 / 4;
				}

				.item-2,
				.item-7 {
					aspect-ratio: 4 / 3;
				}

				.reflection-content {
					grid-template-columns: 1fr;
					gap: 1.25rem;
				}
			}

			@media (max-width: 600px) {
				.creative-inner {
					padding: 3rem 1rem 4rem;
				}

				.creative-hero {
					padding-bottom: 3rem;
				}

				.creative-copy h1 {
					font-size: 2rem;
				}

				.art-gallery {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 0.55rem;
				}

				.gallery-section {
					padding: 3rem 0;
				}

				.reflection {
					padding-top: 3rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="creative-page">
				<div class="creative-inner">

					<!-- =========================
					     TOP
					     ========================= -->

					<section class="creative-hero">

						<div class="creative-copy">

							<span class="eyebrow">
								Creative Practice
							</span>

							<h1>
								Making, testing, and learning
							</h1>

							<p>
								Art and engineering are built on many of the same habits,
								shaped by observation, prototyping, testing, and refinement.
							</p>

							<p>
								I’ve learned a lot from ideas that looked good on paper but
								changed once they encountered real materials, real constraints,
								or real people. Those moments have made me more willing to
								question assumptions, pay attention to detail, and treat
								iteration as an essential part of the process. Whether I’m
								working in ceramics, creating a prototype, or designing, I’m
								most interested in thoughtful, human-centered design that is
								truly helpful for the people it is made for.
							</p>

							<div class="practice-line">
								<span>Observe</span>
								<span class="arrow">→</span>
								<span>Prototype</span>
								<span class="arrow">→</span>
								<span>Test</span>
								<span class="arrow">→</span>
								<span>Refine</span>
							</div>

						</div>

						<div class="hero-image">
							<img
								src="/IMG_1311.jpeg"
								alt="Handmade ceramic teapots"
							/>
						</div>

					</section>


					<!-- =========================
					     GALLERY
					     ========================= -->

					<section class="gallery-section">

						<div class="section-heading">
							<span class="eyebrow">
								Selected Work
							</span>

							<h2>
								Ceramics & visual studies
							</h2>
						</div>

						<div class="art-gallery">

							<!-- Ceramics -->
							<div class="gallery-image item-1">
								<img
									src="/IMG_6940.jpeg"
									alt="Handmade ceramic mugs"
								/>
							</div>

							<!-- Sketch -->
							<div class="gallery-image item-2">
								<img
									src="/IMG_4436.jpeg"
									alt="Outdoor observational ink sketch"
								/>
							</div>

							<!-- Ceramics -->
							<div class="gallery-image item-3">
								<img
									src="/IMG_6074.jpeg"
									alt="Glazed ceramic vessel"
								/>
							</div>

							<!-- Sketch -->
							<div class="gallery-image item-4">
								<img
									src="/IMG_4435.jpeg"
									alt="Observational ink sketch"
								/>
							</div>

							<!-- Sketch -->
							<div class="gallery-image item-5">
								<img
									src="/IMG_4433.jpeg"
									alt="Ink study of hands"
								/>
							</div>

							<!-- Sketch -->
							<div class="gallery-image item-6">
								<img
									src="/IMG_4434.jpeg"
									alt="Ink sketch of a resting cat"
								/>
							</div>

							<!-- Ceramics -->
							<div class="gallery-image item-7">
								<img
									src="/IMG_6936.jpeg"
									alt="Handmade glazed ceramic bowl"
								/>
							</div>

							<!-- Paintings lower in the collage -->
							<div class="gallery-image item-8">
								<img
									src="/IMG_0247.jpeg"
									alt="Portrait painting"
								/>
							</div>

							<div class="gallery-image item-9">
								<img
									src="/IMG_0248.jpeg"
									alt="Portrait painting"
								/>
							</div>

						</div>

					</section>

				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
