---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Creative Practice | ${SITE_TITLE}`}
			description="Ceramics, sketching, visual design, and the creative practices that shape how I approach engineering."
		/>

		<style>
			main {
				max-width: none;
				padding: 0;
				background: #050814;
			}

			.creative-page {
				min-height: 100vh;
				background:
					radial-gradient(
						ellipse at 18% 6%,
						rgba(49, 70, 105, 0.25) 0%,
						transparent 50%
					),
					radial-gradient(
						ellipse at 82% 30%,
						rgba(35, 50, 78, 0.14) 0%,
						transparent 45%
					),
					#050814;
			}

			.creative-inner {
				max-width: 1100px;
				margin: 0 auto;
				padding: 4.5rem 0 6rem;
			}

			/* =========================
			   HEADER
			   ========================= */

			.page-header {
				padding-bottom: 2rem;
				border-bottom: 1px solid #334155;
			}

			.page-header h1 {
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: clamp(2rem, 3vw, 2.6rem);
				font-weight: 700;
				color: var(--color-text-main);
			}

			.page-header p {
				max-width: 720px;
				margin: 1rem 0 0;
				font-size: 1rem;
				line-height: 1.7;
				color: var(--color-text-muted);
			}

			/* =========================
			   INTRO
			   ========================= */

			.intro {
				display: grid;
				grid-template-columns: 1.15fr 0.85fr;
				gap: 5rem;
				align-items: start;
				padding: 4rem 0;
			}

			.intro h2,
			.section-heading {
				display: block;
				margin: 0 0 1.25rem;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.7rem;
				color: var(--color-text-main);
			}

			.intro-copy p {
				margin: 0 0 1.2rem;
				font-size: 1rem;
				line-height: 1.8;
				color: var(--color-text-main);
			}

			.intro-copy p:last-child {
				margin-bottom: 0;
			}

			.intro-quote {
				padding: 1.5rem 0 1.5rem 1.5rem;
				border-left: 2px solid #80b7f4;
			}

			.intro-quote p {
				margin: 0;
				font-family: var(--font-serif);
				font-size: 1.25rem;
				line-height: 1.6;
				color: #cbd5e1;
			}

			/* =========================
			   CONNECTION
			   ========================= */

			.connection {
				padding: 3.5rem 0;
				border-top: 1px solid #334155;
				border-bottom: 1px solid #334155;
			}

			.connection-intro {
				max-width: 760px;
				margin: 0 0 2rem;
				font-size: 0.98rem;
				line-height: 1.8;
				color: var(--color-text-muted);
			}

			.practice-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1rem;
			}

			.practice-item {
				padding: 1.4rem;
				border: 1px solid #334155;
				border-radius: 12px;
				background: rgba(15, 23, 42, 0.35);
			}

			.practice-number {
				display: block;
				margin-bottom: 1rem;
				font-family: var(--font-serif);
				font-size: 0.9rem;
				color: #80b7f4;
			}

			.practice-item h3 {
				margin: 0 0 0.55rem;
				font-family: var(--font-serif);
				font-size: 1.05rem;
				color: var(--color-text-main);
			}

			.practice-item p {
				margin: 0;
				font-size: 0.82rem;
				line-height: 1.65;
				color: var(--color-text-muted);
			}

			/* =========================
			   GALLERY
			   ========================= */

			.work-section {
				padding: 4rem 0;
			}

			.work-intro {
				max-width: 680px;
				margin: -0.4rem 0 2rem;
				font-size: 0.95rem;
				line-height: 1.7;
				color: var(--color-text-muted);
			}

			.gallery {
				display: grid;
				grid-template-columns: 1.2fr 0.8fr;
				grid-template-rows: auto auto;
				gap: 1rem;
			}

			.gallery-item {
				position: relative;
				overflow: hidden;
				min-height: 280px;
				border: 1px solid #334155;
				border-radius: 14px;
				background:
					linear-gradient(
						135deg,
						#172033,
						#0b1020
					);
			}

			.gallery-item.large {
				grid-row: span 2;
				min-height: 580px;
			}

			.gallery-item img {
				width: 100%;
				height: 100%;
				display: block;
				object-fit: cover;
			}

			.gallery-placeholder {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 1rem;
				text-align: center;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #64748b;
			}

			/* =========================
			   MEDIUM GALLERY
			   ========================= */

			.mediums {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
				margin-top: 1.5rem;
			}

			.medium {
				padding-top: 1.25rem;
				border-top: 1px solid #334155;
			}

			.medium h3 {
				margin: 0 0 0.6rem;
				font-family: var(--font-serif);
				font-size: 1.1rem;
				color: var(--color-text-main);
			}

			.medium p {
				margin: 0;
				font-size: 0.85rem;
				line-height: 1.65;
				color: var(--color-text-muted);
			}

			/* =========================
			   REFLECTION
			   ========================= */

			.reflection {
				display: grid;
				grid-template-columns: 0.75fr 1.25fr;
				gap: 5rem;
				padding: 4rem 0 0;
				border-top: 1px solid #334155;
			}

			.reflection h2 {
				display: block;
				margin: 0;
				padding: 0;
				border: none;
				font-family: var(--font-serif);
				font-size: 1.7rem;
				color: var(--color-text-main);
			}

			.reflection-copy p {
				margin: 0 0 1.2rem;
				font-size: 1rem;
				line-height: 1.8;
				color: var(--color-text-main);
			}

			.reflection-copy p:last-child {
				margin-bottom: 0;
			}

			/* =========================
			   RESPONSIVE
			   ========================= */

			@media (max-width: 900px) {
				.creative-inner {
					padding-left: 2rem;
					padding-right: 2rem;
				}

				.intro {
					grid-template-columns: 1fr;
					gap: 2.5rem;
				}

				.practice-grid {
					grid-template-columns: repeat(2, 1fr);
				}

				.reflection {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
			}

			@media (max-width: 650px) {
				.creative-inner {
					padding: 3rem 1rem 4rem;
				}

				.intro {
					padding: 3rem 0;
				}

				.practice-grid,
				.mediums {
					grid-template-columns: 1fr;
				}

				.gallery {
					grid-template-columns: 1fr;
					grid-template-rows: auto;
				}

				.gallery-item,
				.gallery-item.large {
					grid-row: auto;
					min-height: 320px;
				}

				.work-section {
					padding: 3rem 0;
				}

				.reflection {
					padding-top: 3rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="creative-page">
				<div class="creative-inner">

					<!-- =========================
					     PAGE HEADER
					     ========================= -->

					<section class="page-header">
						<h1>Creative Practice</h1>

						<p>
							Ceramics, sketching, and visual design are another part of
							how I learn to make things — through observation,
							experimentation, failure, and refinement.
						</p>
					</section>

					<!-- =========================
					     INTRO
					     ========================= -->

					<section class="intro">
						<div class="intro-copy">
							<h2>Making as a way of thinking</h2>

							<p>
								My interests in ceramics, sketching, and visual design
								strengthen many of the same iterative skills I use in
								engineering: observation, prototyping, material exploration,
								and refinement through critique.
							</p>

							<p>
								Working creatively has taught me to pay attention not only
								to whether something functions, but also to how it feels,
								how it is used, and how decisions about form and material
								shape the final experience.
							</p>
						</div>

						<div class="intro-quote">
							<p>
								Good ideas become better through making, testing,
								seeing what fails, and trying again.
							</p>
						</div>
					</section>

					<!-- =========================
					     ENGINEERING CONNECTION
					     ========================= -->

					<section class="connection">
						<h2 class="section-heading">
							Creative practice → engineering practice
						</h2>

						<p class="connection-intro">
							The medium changes, but the process is surprisingly similar.
							Both creative and engineering work require translating an idea
							into something physical, evaluating what actually happens,
							and being willing to revise it.
						</p>

						<div class="practice-grid">
							<div class="practice-item">
								<span class="practice-number">01</span>

								<h3>Observe</h3>

								<p>
									Pay attention to form, behavior, context, and the
									details that are easy to overlook.
								</p>
							</div>

							<div class="practice-item">
								<span class="practice-number">02</span>

								<h3>Prototype</h3>

								<p>
									Move ideas out of your head and into a form that
									can actually be evaluated.
								</p>
							</div>

							<div class="practice-item">
								<span class="practice-number">03</span>

								<h3>Test</h3>

								<p>
									Let materials, users, and real constraints expose
									assumptions that were invisible on paper.
								</p>
							</div>

							<div class="practice-item">
								<span class="practice-number">04</span>

								<h3>Refine</h3>

								<p>
									Use critique and failure as information, then make
									the next iteration more intentional.
								</p>
							</div>
						</div>
					</section>

					<!-- =========================
					     CREATIVE WORK
					     ========================= -->

					<section class="work-section">
						<h2 class="section-heading">Selected work</h2>

						<p class="work-intro">
							A growing collection of physical and visual work.
							I’ll continue adding process images, experiments,
							and finished pieces here.
						</p>

						<div class="gallery">
							<div class="gallery-item large">
								<div class="gallery-placeholder">
									Add Ceramics Photo
								</div>
							</div>

							<div class="gallery-item">
								<div class="gallery-placeholder">
									Add Sketch / Process Work
								</div>
							</div>

							<div class="gallery-item">
								<div class="gallery-placeholder">
									Add Visual Design Work
								</div>
							</div>
						</div>

						<div class="mediums">
							<div class="medium">
								<h3>Ceramics</h3>
								<p>
									Material exploration, form, fabrication,
									and learning through physical constraints.
								</p>
							</div>

							<div class="medium">
								<h3>Sketching</h3>
								<p>
									A quick way to observe, communicate ideas,
									explore alternatives, and think visually.
								</p>
							</div>

							<div class="medium">
								<h3>Visual Design</h3>
								<p>
									Exploring hierarchy, composition, clarity,
									and how information is experienced.
								</p>
							</div>
						</div>
					</section>

					<!-- =========================
					     REFLECTION
					     ========================= -->

					<section class="reflection">
						<h2>What making has taught me</h2>

						<div class="reflection-copy">
							<p>
								I’ve learned a lot from designs that looked good on paper
								but failed under real constraints. Those moments have made
								me a better builder because they force me to question
								assumptions, understand materials more deeply, and treat
								iteration as part of the process rather than as a correction
								at the end.
							</p>

							<p>
								I also value community, service, and making things that
								feel tangible and useful. Whether I’m working on an
								engineering prototype or something made by hand, I’m most
								interested in work that connects thoughtful design with
								real people and real experiences.
							</p>
						</div>
					</section>

				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
