---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { url } from '../utils/paths';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About Me | ${SITE_TITLE}`}
			description="Learn more about my background, interests, research, and creative work."
		/>

		<style>
			main {
				max-width: none;
				padding: 0;
				background: #050814;
			}

			.about-page {
				min-height: 100vh;
				background:
					radial-gradient(
						ellipse at 18% 8%,
						rgba(49, 70, 105, 0.28) 0%,
						rgba(28, 41, 65, 0.12) 32%,
						transparent 58%
					),
					radial-gradient(
						ellipse at 82% 30%,
						rgba(35, 50, 78, 0.16) 0%,
						transparent 50%
					),
					#050814;
			}

			.about-inner {
				max-width: 1100px;
				margin: 0 auto;
				padding: 4.5rem 0 6rem;
			}

			/* =========================
			   PAGE HEADER
			   ========================= */

			.about-header {
				padding-bottom: 2rem;
				border-bottom: 1px solid #334155;
			}

			.about-header h1 {
				margin: 0;
				font-family: var(--font-serif);
				font-size: clamp(2rem, 3vw, 2.6rem);
				font-weight: 700;
				line-height: 1.1;
				color: var(--color-text-main);
			}

			.about-subtitle {
				max-width: 720px;
				margin: 1.25rem 0 0;
				font-size: 1.05rem;
				line-height: 1.7;
				color: var(--color-text-muted);
			}

			/* =========================
			   MAIN CONTENT
			   ========================= */

			.about-content {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 300px;
				gap: 5rem;
				align-items: start;
				padding-top: 3.5rem;
			}

			.about-text {
				max-width: 720px;
			}

			.about-section {
				margin-bottom: 3rem;
			}

			.about-section:last-child {
				margin-bottom: 0;
			}

			.about-section h2 {
				display: block;
				margin: 0 0 1rem;
				padding: 0;
				border: none;

				font-family: var(--font-serif);
				font-size: 1.65rem;
				font-weight: 700;
				color: var(--color-text-main);
			}

			.about-section p {
				margin: 0 0 1.1rem;
				font-size: 1rem;
				line-height: 1.8;
				color: var(--color-text-main);
			}

			.about-section p:last-child {
				margin-bottom: 0;
			}

			.about-section a {
				color: #80b7f4;
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			.about-section a:hover {
				color: #a7cffb;
			}

			/* =========================
			   HEADSHOT
			   ========================= */

			.headshot-wrap {
				position: sticky;
				top: 6rem;
			}

			.headshot {
				display: block;
				width: 100%;
				aspect-ratio: 4 / 5;
				object-fit: cover;
				border-radius: 18px;
				border: 1px solid #334155;
			}

			/* =========================
			   RESPONSIVE
			   ========================= */

			@media (max-width: 900px) {
				.about-inner {
					padding-left: 2rem;
					padding-right: 2rem;
				}

				.about-content {
					grid-template-columns: 1fr;
					gap: 2.5rem;
				}

				.headshot-wrap {
					position: static;
					order: -1;
					max-width: 320px;
				}
			}

			@media (max-width: 600px) {
				.about-inner {
					padding: 3rem 1rem 4rem;
				}

				.about-content {
					padding-top: 2.5rem;
				}

				.about-section {
					margin-bottom: 2.5rem;
				}

				.about-section h2 {
					font-size: 1.45rem;
				}

				.about-section p {
					font-size: 0.98rem;
					line-height: 1.75;
				}

				.headshot-wrap {
					max-width: 100%;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<div class="about-page">
				<div class="about-inner">
					<section class="about-header">
						<h1>About Me</h1>

						<p class="about-subtitle">
							A little context on how I think, what I’m learning, and what I’m
							working toward.
						</p>
					</section>

					<div class="about-content">
						<div class="about-text">
							<section class="about-section">
								<h2>Who I am</h2>

								<p>
									I'm a Northwestern University student studying Biomedical Engineering because I am drawn to issues that connect science, medicine, and design to improve care.  I enjoy the process of using creativity and problem solving to move from a question or idea to something tangible. The common thread in my experiences and projects has been learning to develop human-centered, safe designs grounded in real problems.
								</p>

							</section>

							<section class="about-section">
								<h2>What I care about</h2>

								<p>
									I care about building technologies that make a meaningful difference in patients' lives. Whether researching diabetic wound healing and low-field MRI systems or helping students fabricate prototypes as a Shop Trainer, I've found that I learn the most when something doesn't work the first time. I enjoy breaking down problems, understanding why a solution failed, and iterating until it meets its goals. Through projects such as designing an interactive robotics system for adults with cognitive and developmental disabilities at Misericordia, I've also come to appreciate the importance of engaging directly with end users to understand their needs and design solutions that are genuinely useful rather than simply technically impressive. I'm especially drawn to work that combines technical problem solving with healthcare and ultimately helps deliver better tools, treatments, or outcomes for patients and healthcare workers.								</p>
								<p>
							</section>

							<section class="about-section">
								<h2>A few personal details</h2>

								<p>
									Outside of engineering, I enjoy ceramics, sketching, reading, and spending time outdoors. I like activities that involve making and creating, whether that's building a prototype in the shop or working on a ceramic piece. Creative outlets give me a chance to explore ideas in a different way and have reinforced my appreciation for experimentation, iteration, and learning through the process of making something from scratch.
								</p>
							</section>
						</div>

						<div class="headshot-wrap">
							<img
								src={url('/headshot.jpg')}
								alt="Portrait of Nadia Lotfi"
								class="headshot"
							/>
						</div>
					</div>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
